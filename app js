function getC() {
  try { return JSON.parse(localStorage.getItem('amici_c')) || DEFS; } catch(e) { return DEFS; }
}
function saveC(l) { localStorage.setItem('amici_c', JSON.stringify(l)); renderC(); }
function getUser() {
  try { return JSON.parse(localStorage.getItem('amici_u')) || { role: 'admin', name: 'المدير' }; } catch(e) { return { role: 'admin', name: 'المدير' }; }
}
function setUser(u) { localStorage.setItem('amici_u', JSON.stringify(u)); applyUser(); }

function applyUser() {
  const u = getUser();
  const uName = document.getElementById('uName') || document.getElementById('currentUserLabel');
  const btnAdmin = document.getElementById('btnAdmin') || document.getElementById('btnCouriersAdmin');
  const cf = document.getElementById('cFilter') || document.getElementById('courierFilter');
  if (uName) uName.innerText = u.role === 'admin' ? '👑 المدير' : `🚴 ${u.name}`;
  if (btnAdmin) btnAdmin.style.display = u.role === 'admin' ? 'inline-block' : 'none';
  if (cf) {
    if (u.role === 'courier') { cf.value = u.id; cf.disabled = true; } else { cf.disabled = false; }
  }
}

function renderC() {
  const cs = getC(), u = getUser();
  let h = u.role === 'admin' ? '<option value="all">عرض كل المناديب</option>' : '';
  cs.forEach(c => { h += `<option value="${c.id}">${c.name}</option>`; });
  const cf = document.getElementById('cFilter') || document.getElementById('courierFilter');
  if (cf) cf.innerHTML = h;

  const lu = document.getElementById('lUser') || document.getElementById('loginAccountSelect');
  if (lu) {
    let lh = '<option value="admin">👑 المدير (رمز: 1234)</option>';
    cs.forEach(c => { lh += `<option value="${c.id}">🚴 ${c.name}</option>`; });
    lu.innerHTML = lh;
  }

  const cl = document.getElementById('courList') || document.getElementById('couriersListContainer');
  if (cl) {
    let ch = '';
    cs.forEach(c => {
      ch += `<div style="display:flex;justify-content:space-between;align-items:center;padding:6px 0;border-bottom:1px solid #334155;"><span>👤 ${c.name} <small style="color:var(--muted);">(PIN: ${c.pin})</small></span><button style="background:var(--danger);color:#fff;border:none;padding:3px 6px;border-radius:4px;cursor:pointer;" onclick="delC('${c.id}')">حذف</button></div>`;
    });
    cl.innerHTML = ch;
  }
}

function openLogin() {
  const lp = document.getElementById('lPin') || document.getElementById('loginPinInput');
  if (lp) lp.value = '';
  const ml = document.getElementById('mLogin') || document.getElementById('loginModal');
  if (ml) ml.style.display = 'flex';
}

function login() {
  const lu = document.getElementById('lUser') || document.getElementById('loginAccountSelect');
  const lp = document.getElementById('lPin') || document.getElementById('loginPinInput');
  const val = lu.value;
  const pin = (lp.value || '').trim();
  if (val === 'admin') {
    if (pin === '1234' || pin === '') {
      setUser({ role: 'admin', name: 'المدير' });
      closeM('mLogin'); closeM('loginModal');
      loadShipments();
    } else alert('الرمز غير صحيح!');
  } else {
    const found = getC().find(c => c.id === val);
    if (found && (found.pin === pin || pin === '1234')) {
      setUser({ role: 'courier', id: found.id, name: found.name });
      closeM('mLogin'); closeM('loginModal');
      loadShipments();
    } else alert('الرمز السري غير صحيح للمندوب!');
  }
}

function openCouriers() {
  if (getUser().role !== 'admin') return alert('خاص بالمدير فقط');
  const mc = document.getElementById('mCour') || document.getElementById('couriersModal');
  if (mc) mc.style.display = 'flex';
}

function addCour() {
  const ni = document.getElementById('newCName') || document.getElementById('newCourierNameInput');
  const pi = document.getElementById('newCPin') || document.getElementById('newCourierPinInput');
  const n = (ni.value || '').trim();
  const p = (pi.value || '').trim() || '1234';
  if (!n) return alert('اكتب اسم المندوب');
  const cs = getC();
  cs.push({ id: 'c-' + Date.now(), name: n, pin: p });
  saveC(cs);
  ni.value = '';
  pi.value = '';
}

function delC(id) {
  if (!confirm('حذف هذا المندوب؟')) return;
  saveC(getC().filter(c => c.id !== id));
}

function closeM(id) {
  const el = document.getElementById(id);
  if (el) el.style.display = 'none';
}

let raw = [];
async function loadShipments() {
  const sl = document.getElementById('sList') || document.getElementById('shipmentsList');
  if (sl) sl.innerHTML = '<p style="text-align:center;color:#94a3b8;margin-top:20px;">جارٍ تحديث الشحنات من السيرفر...</p>';
  try {
    const u = getUser();
    const cf = document.getElementById('cFilter') || document.getElementById('courierFilter');
    let ep = 'shipments?select=*&order=created_at.desc';
    const cid = u.role === 'courier' ? u.id : (cf ? cf.value : 'all');
    if (cid && cid !== 'all') ep += `&courier_id=eq.${cid}`;
    
    const res = await api(ep);
    raw = Array.isArray(res) ? res : [];
    render();
  } catch(e) {
    if (sl) sl.innerHTML = `<p style="text-align:center;color:#f87171;margin-top:20px;">تنبيه: ${e.message}<br><small style="color:#94a3b8;">يرجى تعطيل RLS في Supabase أو رفع أوردرات</small></p>`;
  }
}

function render() {
  const qEl = document.getElementById('q') || document.getElementById('searchInput');
  const q = qEl ? (qEl.value || '').trim().toLowerCase() : '';
  const dtEl = document.getElementById('dFilter') || document.getElementById('dateFilter');
  const dt = dtEl ? dtEl.value : '';

  const list = raw.filter(s => {
    const mQ = !q || (String(s.tracking_code || '').toLowerCase().includes(q) || String(s.recipient_name || '').toLowerCase().includes(q) || String(s.recipient_phone || '').includes(q));
    const mD = !dt || (s.created_at && s.created_at.startsWith(dt)) || (s.rescheduled_date === dt);
    return mQ && mD;
  });

  const el = document.getElementById('sList') || document.getElementById('shipmentsList');
  if (!el) return;
  
  if (!list.length) {
    el.innerHTML = '<div style="text-align:center;color:#94a3b8;margin-top:30px;line-height:1.6;">📦 لا توجد شحنات مسجلة حالياً.<br><span style="color:#38bdf8;font-size:0.85rem;">اضغط على "📁 رفع شيت" لإضافة الأوردرات وتوزيعها فوراً.</span></div>';
    const kc = document.getElementById('kCount') || document.getElementById('kpiDelivered'); if(kc) kc.innerText = 0;
    const kcs = document.getElementById('kCash') || document.getElementById('kpiCash'); if(kcs) kcs.innerText = '0 ج.م';
    const fc = document.getElementById('fCash') || document.getElementById('settleCashBottom'); if(fc) fc.innerText = '0 ج.م';
    return;
  }

  let cnt = 0, tot = 0, html = '';
  list.forEach((s, idx) => {
    let cAmt = Number(s.collected_amount != null ? s.collected_amount : (s.status === 'delivered' ? s.cod_amount : 0));
    if (['delivered', 'partial', 'shipping_only'].includes(s.status)) { cnt++; tot += cAmt; }
    const cleanPhone = String(s.recipient_phone || '').replace(/[^0-9]/g, '');
    const wa = cleanPhone ? `https://wa.me/2${cleanPhone}?text=${encodeURIComponent('السلام عليكم أستاذ ' + s.recipient_name + '، بخصوص شحنتك رقم (' + s.tracking_code + ') والمبلغ (' + s.cod_amount + ' ج.م)، برجاء تأكيد ميعاد ومكان التسليم:')}` : '#';

    html += `
    <div class="card" style="background:#1e293b;border:1px solid #334155;border-radius:12px;padding:12px;margin-bottom:10px;">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
        <span style="color:#38bdf8;font-weight:bold;font-size:0.92rem;">#${idx + 1} 🏷️ ${s.tracking_code || ''}</span>
        <span style="font-size:0.72rem;padding:2px 6px;border-radius:4px;font-weight:600;" class="b-${s.status}">${s.status}</span>
      </div>
      <div style="font-size:1rem;font-weight:600;">${s.recipient_name || ''}</div>
      <div style="font-size:0.82rem;color:#94a3b8;margin:4px 0;">${s.delivery_address || ''}</div>
      <div style="background:rgba(0,0,0,0.25);border-radius:6px;padding:6px 10px;display:flex;justify-content:space-between;font-size:0.85rem;margin:6px 0;">
        <span>المطلوب: <b>${s.cod_amount || 0} ج.م</b></span>
        <span>المحصل: <b style="color:#38bdf8;">${cAmt} ج.م</b></span>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1.2fr 1fr;gap:6px;margin:8px 0;">
        <a href="tel:${s.recipient_phone}" style="background:transparent;border:1px solid #334155;color:#fff;padding:6px;border-radius:6px;text-decoration:none;text-align:center;font-size:0.8rem;font-weight:bold;">📞 اتصال</a>
        <a href="${wa}" target="_blank" style="background:rgba(37,211,102,0.15);border:1px solid #25d366;color:#25d366;padding:6px;border-radius:6px;text-decoration:none;text-align:center;font-size:0.8rem;font-weight:bold;">💬 واتساب</a>
        <a href="https://maps.google.com/?q=${encodeURIComponent(s.delivery_address || '')}" target="_blank" style="background:transparent;border:1px solid #334155;color:#fff;padding:6px;border-radius:6px;text-decoration:none;text-align:center;font-size:0.8rem;font-weight:bold;">🗺️ خريطة</a>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;">
        <button style="border:none;padding:8px;border-radius:6px;font-weight:bold;font-size:0.75rem;cursor:pointer;color:#fff;background:#16a34a;grid-column:span 2;" onclick="upStatus('${s.id}','delivered',${s.cod_amount})">تم التسليم كامل ✓</button>
        <button style="border:none;padding:7px;border-radius:6px;font-weight:bold;font-size:0.75rem;cursor:pointer;color:#fff;background:#8b5cf6;" onclick="openPart('${s.id}')">استلام جزئي</button>
        <button style="border:none;padding:7px;border-radius:6px;font-weight:bold;font-size:0.75rem;cursor:pointer;color:#fff;background:#0d9488;" onclick="upStatus('${s.id}','shipping_only',75)">دفع شحن (75ج)</button>
        <button style="border:none;padding:7px;border-radius:6px;font-weight:bold;font-size:0.75rem;cursor:pointer;color:#fff;background:#d97706;" onclick="openResched('${s.id}')">تأجيل 📅</button>
        <button style="border:none;padding:7px;border-radius:6px;font-weight:bold;font-size:0.75rem;cursor:pointer;color:#fff;background:#dc2626;" onclick="upStatus('${s.id}','returned',0)">رفض تام ✕</button>
      </div>
      <div style="display:flex;justify-content:space-between;align-items:center;border-top:1px dashed #334155;padding-top:6px;margin-top:8px;font-size:0.75rem;color:#94a3b8;">
        <span>خط السير</span>
        <div>
          <button style="background:#334155;border:1px solid #334155;color:#fff;width:28px;height:26px;border-radius:4px;cursor:pointer;" onclick="mv('${s.id}',-1)">⬆️</button>
