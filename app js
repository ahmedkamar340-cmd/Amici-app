  if (ml) ml.style.display = 'flex';
}

function login() {
  const val = document.getElementById('lUser').value;
  const pin = (document.getElementById('lPin').value || '').trim();
  if (val === 'admin') {
    if (pin === '1234' || pin === '') {
      setUser({ role: 'admin', name: 'المدير' });
      closeM('mLogin');
      loadShipments();
    } else alert('الرمز غير صحيح!');
  } else {
    const found = getC().find(c => c.id === val);
    if (found && (found.pin === pin || pin === '1234')) {
      setUser({ role: 'courier', id: found.id, name: found.name });
      closeM('mLogin');
      loadShipments();
    } else alert('الرمز السري غير صحيح للمندوب!');
  }
}

function openCouriers() {
  if (getUser().role !== 'admin') return alert('خاص بالمدير فقط');
  const mc = document.getElementById('mCour');
  if (mc) mc.style.display = 'flex';
}

function addCour() {
  const n = (document.getElementById('newCName').value || '').trim();
  const p = (document.getElementById('newCPin').value || '').trim() || '1234';
  if (!n) return alert('اكتب اسم المندوب');
  const cs = getC();
  cs.push({ id: 'c-' + Date.now(), name: n, pin: p });
  saveC(cs);
  document.getElementById('newCName').value = '';
  document.getElementById('newCPin').value = '';
}

function delC(id) {
  if (!confirm('حذف هذا المندوب؟')) return;
  saveC(getC().filter(c => c.id !== id));
}

function closeM(id) {
  const el = document.getElementById(id);
  if (el) el.style.display = 'none';
}

let raw = [];
async function loadShipments() {
  try {
    const u = getUser(), cf = document.getElementById('cFilter');
    let ep = 'shipments?select=*&order=created_at.desc';
    const cid = u.role === 'courier' ? u.id : (cf ? cf.value : 'all');
    if (cid && cid !== 'all') ep += `&courier_id=eq.${cid}`;
    raw = await api(ep);
    render();
  } catch(e) {
    const sl = document.getElementById('sList');
    if (sl) sl.innerHTML = `<p style="text-align:center;color:#f87171;">خطأ في الاتصال: ${e.message}</p>`;
  }
}

