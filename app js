        </div>
      </div>
    </div>`;
  });

  el.innerHTML = html;
  const kc = document.getElementById('kCount') || document.getElementById('kpiDelivered'); if(kc) kc.innerText = cnt;
  const kcs = document.getElementById('kCash') || document.getElementById('kpiCash'); if(kcs) kcs.innerText = tot + ' ج.م';
  const fc = document.getElementById('fCash') || document.getElementById('settleCashBottom'); if(fc) fc.innerText = tot + ' ج.م';
}

async function upStatus(id, st, amt) {
  await api(`shipments?id=eq.${id}`, 'PATCH', { status: st, collected_amount: amt });
  loadShipments();
}

function openPart(id) {
  const pi = document.getElementById('pId') || document.getElementById('partialShipmentId');
  if (pi) pi.value = id;
  const mp = document.getElementById('mPart') || document.getElementById('partialModal');
  if (mp) mp.style.display = 'flex';
}

async function savePart() {
  const pi = document.getElementById('pId') || document.getElementById('partialShipmentId');
  const pa = document.getElementById('pAmt') || document.getElementById('partialAmountInput');
  const id = pi.value;
  const a = Number(pa.value) || 0;
  await api(`shipments?id=eq.${id}`, 'PATCH', { status: 'partial', collected_amount: a });
  closeM('mPart'); closeM('partialModal');
  loadShipments();
}

function openResched(id) {
  const ri = document.getElementById('rId') || document.getElementById('rescheduleShipmentId');
  if (ri) ri.value = id;
  const mr = document.getElementById('mResched') || document.getElementById('rescheduleModal');
  if (mr) mr.style.display = 'flex';
}

async function saveResched() {
  const ri = document.getElementById('rId') || document.getElementById('rescheduleShipmentId');
  const rd = document.getElementById('rDate') || document.getElementById('rescheduleDateInput');
  const id = ri.value;
  const d = rd.value;
  if (!d) return alert('حدد التاريخ');
  await api(`shipments?id=eq.${id}`, 'PATCH', { status: 'rescheduled', rescheduled_date: d });
  closeM('mResched'); closeM('rescheduleModal');
  loadShipments();
}

function mv(id, dir) {
  const i = raw.findIndex(s => s.id === id);
  if (i < 0 || i + dir < 0 || i + dir >= raw.length) return;
  const item = raw.splice(i, 1)[0];
  raw.splice(i + dir, 0, item);
  render();
}

function settle() {
  const fc = document.getElementById('fCash') || document.getElementById('settleCashBottom');
  alert(`إجمالي النقدية المحصلة: ${fc ? fc.innerText : '0 ج.م'}`);
}

renderC();
applyUser();
loadShipments();
