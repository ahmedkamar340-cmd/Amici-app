async function api(ep, m = 'GET', b = null) {
  const opt = {
    method: m,
    headers: {
      'apikey': S_KEY,
      'Authorization': `Bearer ${S_KEY}`,
      'Content-Type': 'application/json',
      'Prefer': 'return=representation'
    }
  };
  if (b) opt.body = JSON.stringify(b);
  const r = await fetch(`${S_URL}/rest/v1/${ep}`, opt);
  return await r.json();
}

